DATABASE_URL=postgres://postgres:saas@localhost:5432/saas
# Generate with: openssl rand -base64 32
JWT_SECRET=
# Optional. The port the API listens on (default 3000).
# PORT=3000
# Optional. Browser origins allowed to call the API, comma-separated (default: none).
# CORS_ORIGINS=http://localhost:5173
# Optional. The frontend that invitation links point to (default http://localhost:5173).
# APP_URL=http://localhost:5173
# Optional. development, test or production (default development).
# NODE_ENV=development
# NestJS Observe: `npx @nestjs/observe link` writes these. Empty: nothing is sent.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
